{
  "server": {
    "host": "127.0.0.1",
    "port": 8080
  },
  "database": {
    "url": "postgres://llmwiki:test123@localhost:5433/llmwiki",
    "max_connections": 10
  },
  "redis_url": "redis://localhost:6380",
  "jwt": {
    "secret": "",
    "access_token_ttl": 300,
    "refresh_token_ttl": 604800
  },
  "storage": {
    "path": "/tmp/llmwiki_storage"
  },
  "cors": {
    "allowed_origins": ["http://localhost:1420", "http://localhost:5173"]
  },
  "auth": {
    "registration_enabled": false
  },
  "page_rate_limits": {
    "s_per_min": 30,
    "beacon_per_min": 60
  },
  "embedding": {
    "base_url": "http://localhost:8001/v1",
    "model": "bge-m3-mlx-fp16",
    "dim": 1024,
    "timeout_secs": 60
  },
  "frontend": {
    "dist_dir": "../dist",
    "index_html": "../dist/index.html"
  },
  "llm_timeout_secs": 120
}
