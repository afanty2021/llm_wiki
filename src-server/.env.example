# config crate Environment separator 为 "__"：嵌套键必须双下划线（SERVER__HOST），
# 单下划线形态（HOST、DATABASE_URL 等）会被静默忽略——本文件全部键均已对照 config.rs 核实。
# 顶层标量键（REDIS_URL/ADMIN_USERNAMES）无嵌套，单形态即正确。

# 服务器（默认仅回环监听；容器部署由 docker-compose.prod.yml 覆盖为 0.0.0.0）
SERVER__HOST=127.0.0.1
SERVER__PORT=8080

# 数据库
DATABASE__URL=postgresql://llmwiki:test123@localhost:5433/llmwiki
DATABASE__MAX_CONNECTIONS=10

# Redis（顶层标量，无需 __）
REDIS_URL=redis://localhost:6380

# JWT
JWT__SECRET=your-super-secret-key-change-this
JWT__ACCESS_TOKEN_TTL=300  # 5 分钟
JWT__REFRESH_TOKEN_TTL=604800  # 7 天

# 文件存储（S3 段嵌套在 storage 下，同样需要 STORAGE__ 前缀）
STORAGE__PATH=/data/storage
STORAGE__TYPE=local  # local 或 s3
# STORAGE__S3_ENDPOINT=
# STORAGE__S3_ACCESS_KEY=
# STORAGE__S3_SECRET_KEY=
# STORAGE__S3_BUCKET=
# STORAGE__S3_REGION=us-east-1

# CORS
CORS__ALLOWED_ORIGINS=http://localhost:1420,http://192.168.1.100

# 日志（RUST_LOG 无消费者，级别旋钮是 LOGGING__LEVEL）
LOGGING__LEVEL=info

# 注册开关（Task 6 r3 fail-closed）：default.json 默认 false；dev 需注册时在此显式开启
AUTH__REGISTRATION_ENABLED=true

# 师训域（TRAINING__ADMIN_TOKEN 非空时强制 ≥32 字节，config.rs 启动校验）
TRAINING__ADMIN_TOKEN=
TRAINING__PROJECT_ID=

# 媒体签名（SIGNING_KEY 非空 + ALLOWED_ROOTS 为空 → 拒绝启动，fail-closed；
# ALLOWED_ROOTS 逗号分隔，须涵盖存量 media_ref/playback_path 的全部父目录）
MEDIA__SIGNING_KEY=
MEDIA__ALLOWED_ROOTS=

# /t/ /s/ 限流（每分钟）
PAGE_RATE_LIMITS__S_PER_MIN=30
PAGE_RATE_LIMITS__BEACON_PER_MIN=60
