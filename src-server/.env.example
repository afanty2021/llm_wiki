# 数据库
DATABASE_URL=postgresql://llmwiki:test123@localhost:5433/llmwiki
DATABASE_MAX_CONNECTIONS=10

# Redis
REDIS_URL=redis://localhost:6380

# JWT（嵌套键须用双下划线——config.rs Environment separator 为 "__"，单下划线不生效）
JWT__SECRET=your-super-secret-key-change-this
JWT__ACCESS_TOKEN_TTL=300  # 5 分钟
JWT__REFRESH_TOKEN_TTL=604800  # 7 天

# 文件存储
STORAGE_PATH=/data/storage
STORAGE_TYPE=local  # local 或 s3

# S3 配置（可选）
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=us-east-1

# 服务器（默认仅回环监听；容器部署由 docker-compose.prod.yml 覆盖为 0.0.0.0）
HOST=127.0.0.1
PORT=8080

# CORS
ALLOWED_ORIGINS=http://localhost:1420,http://192.168.1.100

# 日志
RUST_LOG=info
