<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>wiki.caddy-lan</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/caddy</string>
		<string>run</string>
		<string>--config</string>
		<string>/opt/homebrew/etc/caddy/ltutor-lan.Caddyfile</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<!-- CF API token：Zone→DNS→Edit，Zone resources 限定 xiaoluedu.top 单 zone。
		     实装文件 chmod 600；本模板不入真值。 -->
		<key>CF_DNS_TOKEN</key>
		<string>REPLACE_ME_CF_DNS_TOKEN</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/berton/Library/Logs/caddy-lan.err.log</string>
	<key>LimitLoadToSessionType</key>
	<array>
		<string>Aqua</string>
		<string>Background</string>
	</array>
</dict>
</plist>
